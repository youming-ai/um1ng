---
import '@fontsource-variable/inter';
import '../styles.css';
import Skull from '../Skull.astro';

const links = [
    { text: 'X', href: 'https://x.com/youming_ai' },
    { text: 'GitHub', href: 'https://github.com/youming-ai' }
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>um1ng</title>
        <meta name="description" content="um1ng" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="relative h-dvh overflow-hidden bg-[radial-gradient(ellipse_at_center,#4a4640_0%,#22201d_45%,#121110_100%)] font-sans antialiased">
        <Skull />
        <footer class="rise absolute inset-x-0 bottom-10 flex justify-center gap-8 text-stone-400">
            {links.map((l) => <a href={l.href} class="hover:text-white">{l.text}</a>)}
        </footer>
    </body>
</html>
